      "note": "URDF 源；urdf/ 生成物为入库权威，xacro/ 源存档溯源（修正 8）"
    },
    {
      "name": "unitree_mujoco",
      "repo": "unitreerobotics/unitree_mujoco",
      "pin": "1eb6642e3f3fdfb7fb13a9794fd6a2dd93ea0e7d",
      "subdir": "unitree_robots/go2",
      "license_path": "LICENSE",
